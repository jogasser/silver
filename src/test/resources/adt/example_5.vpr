adt DAG[T] {
    EmptyNode(v: T)
    Node(value: T, successor: Seq[DAG[T]])
}

function toSeqs(dags: Seq[DAG[Int]]): Seq[Int] {
    (|dags| > 0 ? toSeq(dags[0]) ++ toSeqs(dags[1..]) : Seq())
}

function toSeq(dag: DAG[Int]): Seq[Int] {
    (|dag.successor| > 0 ? Seq(dag.value) ++ toSeqs(dag.successor) : Seq(dag.value))
}

method client()
{
   var dag: DAG[Int]

   dag := Node(1, Seq(
        Node(2, Seq(Node(3, Seq()))),
        Node(2, Seq(Node(3, Seq()))),
        Node(2, Seq()),
        Node(2, Seq()),
        Node(2, Seq())
   ))

   assert toSeq(dag) == Seq(1) ++ toSeqs(dag.successor)

   assert toSeq(dag) == Seq(1, 2, 3, 2, 3, 2, 2, 2)
}