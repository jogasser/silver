adt Option[T] {
    Some(value:T)
    None()
}

function add(a:Option[Int], b: Option[Int]): Option[Int] {
      ((a.isSome && b.isSome) ? Some(a.value + b.value) : None())
}
function addSeq(a:Option[Seq[Int]], b: Option[Seq[Int]]): Option[Seq[Int]] {
      ((a.isSome && b.isSome) ? Some(a.value ++ b.value) : None())
}

method request(arg: Int) returns (res: Option[Int]) 
ensures arg > 0 ==> res.isSome && res == Some(2*arg)
ensures arg < 0 ==> res.isNone
{
    if (arg > 0)
    {   
        res:= add(Some(arg), Some(arg))
    }
    else
    {
        res:= None()
    }
}

method client() {

    var response: Option[Int]
    response := request(1)
    if (response.isSome)
    {
        // resquest successfull
        assert response.value == 2

        var o: Option[Int]
        o := Some(3)

        assert add(response, None()) == None()
        assert add(o, response).value == 5

        assert addSeq(Some(Seq(1,2,3)), Some(Seq(1,2,3))).value == Seq(1,2,3,1,2,3)
    }
    else
    {
        assert false
    }



    response := request(-1)
    assert response.isNone
    if (response.isSome)
    {
        // resquest successfull
        assert false

    }
    else
    {
        assert true
    }

}